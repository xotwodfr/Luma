# Copy to deploy/.env, fill in, then: chmod 600 deploy/.env
# deploy/.env is gitignored and is never overwritten by any script.

# Database password. Must be URL-safe; generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# age public key (age1…) that backups are encrypted to. Generate the key pair on another
# machine (age-keygen -o luma-backup.key) and keep the private key OFF this server.
LUMA_BACKUP_RECIPIENT=

# Optional (defaults shown).
# LUMA_PUBLIC_URL=https://chat.folk3s.com
# LUMA_REGISTRATION=invite
# LUMA_MAX_UPLOAD_BYTES=26214400
# LUMA_PORT=8790
# LUMA_SUBNET=172.16.79.0/24
# LUMA_GATEWAY=172.16.79.1
